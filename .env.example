AIRFLOW_IMAGE_NAME=apache/airflow:3.3.0
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_API_JWT_SECRET=replace-for-non-local-use
AIRFLOW_FERNET_KEY=

# Local MVP: the downloaded lightweight samples under the sibling aiserver repo.
AIHUB_DATA_MODE=SAMPLE
AIHUB_DATASET_ROOT=../aiserver/sample
